# Copie este arquivo para ".env" (no PowerShell: copy .env.example .env).
# O arquivo .env NÃO vai para o GitHub.
# A chave do Gemini NÃO fica aqui: ela é cadastrada dentro do n8n, em Credentials.

# Versão do n8n. Depois da primeira execução, veja a versão em Settings > About
# no n8n e troque "latest" por ela (ex.: N8N_VERSION=1.xx.x) para fixar a versão.
N8N_VERSION=latest

# Fuso horário usado pelo n8n.
TIMEZONE=America/Sao_Paulo
