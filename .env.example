# Modelo de configuração. Copie para ".env" (no PowerShell: copy .env.example .env).
# O arquivo .env NÃO vai para o GitHub (ver .gitignore).
# A chave do Gemini NÃO fica aqui: ela é cadastrada nas Credentials do n8n.

# Versão fixa da imagem do n8n (RNF05). Tag verificada no Docker Hub.
# Para atualizar, troque o número e rode: docker compose up -d
N8N_VERSION=2.45.6

# Fuso horário do n8n e dos registros de data e hora (RNF05, registro de execução).
TIMEZONE=America/Sao_Paulo
